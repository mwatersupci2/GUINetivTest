<Netiv="research/netiv-gui-bridge/lib/host/windows.ntv">
○|
  □|
    <meta>{
      name: "gui.host.windows",
      kind: "library",
      namespace: "gui.host.windows",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.runtime.loop,gui.kiosk.screen",
      target: "windows-native-window",
      notes: "Defines the Windows host boundary for the Netiv trinary GUI runtime. Win32 window, message pump, and presentation concerns stay here instead of leaking into display, canvas, or kiosk libraries."
    };

    <edges>{
      %% graph TD
      %%   WindowsHost --> WindowsDisplayMode
      %%   WindowsHost --> RuntimeLoop
      %%   WindowsHost --> KioskScreen
      %%   HostBootWindow --> WindowsHost
      %%   HostPumpMessages --> WindowsHost
      %%   HostShutdownWindow --> WindowsHost
    };

    <book>{
      °enum •WindowsDisplayMode {
        •windowed,
        •borderless,
        •fullscreen,
        •headless
      };

      °struct •WindowsHost {
        °define •mode: •WindowsDisplayMode;
        °define •initialized: °bool;
        °define •running: °bool;
        °define •messagePumpActive: °bool;
      };

      °function •MakeWindowsHost {
        °define •mode: •WindowsDisplayMode;
        °return •WindowsHost;
      };

      °function •HostBootWindow {
        °define •host: •WindowsHost;
        °define •loop: •RuntimeLoop;
        °set •host.initialized = true;
        °set •host.running = true;
        °set •host.messagePumpActive = true;
        °return •host;
      };

      °function •HostPumpMessages {
        °define •host: •WindowsHost;
        °if { •host.running == false } {
          °set •host.messagePumpActive = false;
          °return •host;
        };
        °set •host.messagePumpActive = true;
        °return •host;
      };

      °function •HostShutdownWindow {
        °define •host: •WindowsHost;
        °set •host.running = false;
        °set •host.messagePumpActive = false;
        °return •host;
      };
    };
  |■
|●
