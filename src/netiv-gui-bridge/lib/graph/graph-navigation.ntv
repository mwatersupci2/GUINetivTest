<Netiv="research/netiv-gui-bridge/lib/graph/graph-navigation.ntv">
○|
  □|
    <meta>{
      name: "gui.graph.graph_navigation",
      kind: "library",
      namespace: "gui.graph.graph_navigation",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.graph.flatfile_graph,gui.graph.graph_canvas,gui.kiosk.event_propagation",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines hyperlink navigation between rendered flatfile graph nodes and graph canvases."
    };

    <edges>{
      %% graph TD
      %%   GraphNavigation --> GraphCanvas
      %%   GraphNavigation --> GraphNode
      %%   GraphNavigation --> FlatfileDocument
      %%   NavigateGraphNode --> GraphNode
      %%   NavigateGraphNode --> FlatfileGraph
      %%   OpenGraphCanvas --> GraphCanvas
    };

    <book>{
      °struct •GraphNavigation {
        °define •currentNode: °usize;
        °define •navigationCount: °usize;
      };

      °function •MakeGraphNavigation {
        °return •GraphNavigation;
      };

      °function •NavigateGraphNode {
        °define •navigation: •GraphNavigation;
        °define •node: •GraphNode;
        °set •navigation.currentNode = •node.ordinal;
        °set •navigation.navigationCount = •navigation.navigationCount + 1;
        °return •navigation;
      };

      °function •OpenGraphCanvas {
        °define •navigation: •GraphNavigation;
        °define •canvas: •GraphCanvas;
        °return •navigation;
      };
    };
  |■
|●
