<Netiv="research/netiv-gui-bridge/lib/graph/graph-edge-render.ntv">
○|
  □|
    <meta>{
      name: "gui.graph.graph_edge_render",
      kind: "library",
      namespace: "gui.graph.graph_edge_render",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.display.frame_surface,gui.display.draw_line",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines graph edge rendering behavior for intra-file graph canvases."
    };

    <edges>{
      %% graph TD
      %%   GraphEdgeRender --> FrameSurface
      %%   GraphEdgeRender --> DrawLine
      %%   RenderGraphEdge --> FrameSurface
    };

    <book>{
      °struct •GraphEdgeRender {
        °define •edgeOrdinal: °usize;
        °define •visible: °bool;
      };

      °function •MakeGraphEdgeRender {
        °define •edgeOrdinal: °usize;
        °return •GraphEdgeRender;
      };

      °function •RenderGraphEdge {
        °define •surface: •FrameSurface;
        °define •edge: •GraphEdgeRender;

        °set •surface.dirty = true;
        °set •surface.writeCount = •surface.writeCount + 1;

        °return •surface;
      };
    };
  |■
