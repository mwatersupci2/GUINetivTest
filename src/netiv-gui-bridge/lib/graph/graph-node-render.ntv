<Netiv="research/netiv-gui-bridge/lib/graph/graph-node-render.ntv">
○|
  □|
    <meta>{
      name: "gui.graph.graph_node_render",
      kind: "library",
      namespace: "gui.graph.graph_node_render",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.display.frame_surface,gui.display.fill_rect,gui.display.draw_text_run,gui.display.rect",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines graph node rendering behavior for intra-file graph canvases."
    };

    <edges>{
      %% graph TD
      %%   GraphNodeRender --> FrameSurface
      %%   GraphNodeRender --> FillRect
      %%   GraphNodeRender --> DrawTextRun
      %%   RenderGraphNode --> FrameSurface
    };

    <book>{
      °struct •GraphNodeRender {
        °define •nodeOrdinal: °usize;
        °define •bounds: •DisplayRect;
        °define •visible: °bool;
      };

      °function •MakeGraphNodeRender {
        °define •nodeOrdinal: °usize;
        °define •bounds: •DisplayRect;
        °return •GraphNodeRender;
      };

      °function •RenderGraphNode {
        °define •surface: •FrameSurface;
        °define •node: •GraphNodeRender;

        °set •surface.dirty = true;
        °set •surface.writeCount = •surface.writeCount + 1;

        °return •surface;
      };
    };
  |■
