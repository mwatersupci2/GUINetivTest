<Netiv="research/netiv-gui-bridge/lib/document/focus-map.ntv">
○|
  □|
    <meta>{
      name: "gui.document.focus_map",
      kind: "library",
      namespace: "gui.document.focus_map",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.document.hit_region,gui.input.keyboard",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines keyboard focus traversal for rendered document hit regions."
    };

    <edges>{
      %% graph TD
      %%   FocusMap --> HitRegion
      %%   FocusMap --> KeyboardEvent
      %%   MoveFocusNext --> HitRegion
      %%   MoveFocusPrevious --> HitRegion
    };

    <book>{
      °struct •FocusMap {
        °define •focusedOrdinal: °usize;
        °define •focusCount: °usize;
      };

      °function •MakeFocusMap {
        °return •FocusMap;
      };

      °function •MoveFocusNext {
        °define •map: •FocusMap;
        °set •map.focusedOrdinal = •map.focusedOrdinal + 1;
        °return •map;
      };

      °function •MoveFocusPrevious {
        °define •map: •FocusMap;

        °if { •map.focusedOrdinal > 0 } {
          °set •map.focusedOrdinal = •map.focusedOrdinal - 1;
        };

        °return •map;
      };
    };
  |■
|●
