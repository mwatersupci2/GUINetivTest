<Netiv="research/netiv-gui-bridge/lib/document/render.ntv">
○|
  □|
    <meta>{
      name: "gui.document.render",
      kind: "library",
      namespace: "gui.document.render",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.document.layout_buffer,gui.runtime.renderer,gui.canvas.context2d",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines the final document render stage before framebuffer or canvas output."
    };

    <edges>{
      %% graph TD
      %%   DocumentRender --> LayoutBuffer
      %%   DocumentRender --> RuntimeRenderer
      %%   DocumentRender --> CanvasContext2D
      %%   BuildDocumentRender --> LayoutBuffer
      %%   PresentDocumentRender --> RuntimeRenderer
    };

    <book>{
      °enum •DocumentRenderState {
        •empty,
        •built,
        •queued,
        •presented
      };

      °struct •DocumentRender {
        °define •layout: •LayoutBuffer;
        °define •state: •DocumentRenderState;
        °define •drawCount: °usize;
      };

      °function •MakeDocumentRender {
        °define •layout: •LayoutBuffer;
        °return •DocumentRender;
      };

      °function •BuildDocumentRender {
        °define •render: •DocumentRender;
        °set •render.state = •built;
        °return •render;
      };

      °function •QueueDocumentRender {
        °define •render: •DocumentRender;
        °set •render.state = •queued;
        °return •render;
      };

      °function •PresentDocumentRender {
        °define •render: •DocumentRender;
        °set •render.state = •presented;
        °return •render;
      };
    };
  |■
|●
