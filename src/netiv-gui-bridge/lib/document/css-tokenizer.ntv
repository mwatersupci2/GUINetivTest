<Netiv="research/netiv-gui-bridge/lib/document/css-tokenizer.ntv">
○|
  □|
    <meta>{
      name: "gui.document.css_tokenizer",
      kind: "library",
      namespace: "gui.document.css_tokenizer",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.document.style,gui.document.token_buffer,gui.standards.css_contract",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines CSS token extraction into shared style and token buffers."
    };

    <edges>{
      %% graph TD
      %%   CssTokenizer --> DocumentStyle
      %%   CssTokenizer --> TokenBuffer
      %%   CssTokenizer --> CssContract
    };

    <book>{
      °struct •CssTokenizer {
        °define •tokenCount: °usize;
        °define •validated: °bool;
      };

      °function •MakeCssTokenizer {
        °return •CssTokenizer;
      };

      °function •TokenizeCss {
        °define •tokenizer: •CssTokenizer;
        °define •tokens: •TokenBuffer;
        °set •tokens = •BuildTokenBuffer(•tokens);
        °set •tokenizer.validated = true;
        °return •tokenizer;
      };
    };
  |■
|●
