<Netiv="research/netiv-gui-bridge/lib/document/mermaid-tokenizer.ntv">
○|
  □|
    <meta>{
      name: "gui.document.mermaid_tokenizer",
      kind: "library",
      namespace: "gui.document.mermaid_tokenizer",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.document.token_buffer,gui.graph.flatfile_graph",
      target: "binary-hosted-trinary-runtime",
      notes: "Tokenizer for graph edge rendering."
    };

    <edges>{
      %% graph TD
      %%   MermaidTokenizer --> TokenBuffer
      %%   MermaidTokenizer --> FlatfileGraph
    };

    <book>{
      °struct •MermaidTokenizer {
        °define •tokenCount: °usize;
      };

      °function •MakeMermaidTokenizer {
        °return •MermaidTokenizer;
      };

      °function •TokenizeMermaid {
        °define •tokenizer: •MermaidTokenizer;
        °define •tokens: •TokenBuffer;
        °set •tokens = •BuildTokenBuffer(•tokens);
        °return •tokenizer;
      };
    };
  |■
|●
