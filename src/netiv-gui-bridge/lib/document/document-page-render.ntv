<Netiv="research/netiv-gui-bridge/lib/document/document-page-render.ntv">
○|
  □|
    <meta>{
      name: "gui.document.document_page_render",
      kind: "library",
      namespace: "gui.document.document_page_render",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.document.render_tree,gui.display.frame_surface,gui.document.visible_window",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines composition of visible document regions into frame surfaces."
    };

    <edges>{
      %% graph TD
      %%   DocumentPageRender --> RenderTree
      %%   DocumentPageRender --> FrameSurface
      %%   DocumentPageRender --> VisibleWindow
      %%   RenderDocumentPage --> FrameSurface
    };

    <book>{
      °struct •DocumentPageRender {
        °define •pageOrdinal: °usize;
        °define •visibleCount: °usize;
      };

      °function •MakeDocumentPageRender {
        °define •pageOrdinal: °usize;
        °return •DocumentPageRender;
      };

      °function •RenderDocumentPage {
        °define •surface: •FrameSurface;
        °define •page: •DocumentPageRender;

        °set •surface.dirty = true;
        °set •surface.writeCount = •surface.writeCount + 1;

        °return •surface;
      };
    };
  |■
