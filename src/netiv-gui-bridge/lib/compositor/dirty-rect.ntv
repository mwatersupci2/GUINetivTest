<Netiv="research/netiv-gui-bridge/lib/compositor/dirty-rect.ntv">
○|
  □|
    <meta>{
      name: "gui.compositor.dirty_rect",
      kind: "library",
      namespace: "gui.compositor.dirty_rect",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.display.rect",
      target: "windows-native-window",
      notes: "Tracks changed screen rectangles so the trinary GUI bridge can redraw only the regions that changed."
    };

    <edges>{
      %% graph TD
      %%   DirtyRect --> DisplayRect
      %%   DirtyRectQueue --> DirtyRect
      %%   MarkDirtyRect --> DirtyRectQueue
      %%   MergeDirtyRects --> DirtyRectQueue
      %%   ClearDirtyRects --> DirtyRectQueue
      %%   DirtyRectQueue --> FramebufferFlushBounds
      %%   DirtyRectQueue --> CanvasRedrawBounds
    };

    <book>{
      °struct •DirtyRect {
        °define •bounds: •DisplayRect;
      };

      °struct •DirtyRectQueue {
        °define •screenBounds: •DisplayRect;
        °define •count: °usize;
      };

      °function •MakeDirtyRect {
        °define •bounds: •DisplayRect;
        °return •DirtyRect;
      };

      °function •MakeDirtyRectQueue {
        °define •screenBounds: •DisplayRect;
        °return •DirtyRectQueue;
      };

      °function •MarkDirtyRect {
        °define •queue: •DirtyRectQueue;
        °define •bounds: •DisplayRect;

        °if { •RectIsEmpty(•bounds) } {
          °return •queue;
        };

        °define •clipped: •DisplayRect;
        °set •clipped = •RectClip(•bounds, •queue.screenBounds);

        °if { •RectIsEmpty(•clipped) } {
          °return •queue;
        };

        °set •queue.count = •queue.count + 1;
        °return •queue;
      };

      °function •MarkWholeScreenDirty {
        °define •queue: •DirtyRectQueue;
        °return •MarkDirtyRect(•queue, •queue.screenBounds);
      };

      °function •MergeDirtyRects {
        °define •queue: •DirtyRectQueue;
        °return •queue;
      };

      °function •ClearDirtyRects {
        °define •queue: •DirtyRectQueue;
        °set •queue.count = 0;
        °return •queue;
      };

      °function •HasDirtyRects {
        °define •queue: •DirtyRectQueue;

        °if { •queue.count > 0 } {
          °return true;
        };

        °return false;
      };
    };
  |■
|●
