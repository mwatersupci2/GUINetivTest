<Netiv="research/netiv-gui-bridge/lib/layout/text-wrap.ntv">
○|
  □|
    <meta>{
      name: "gui.layout.text_wrap",
      kind: "library",
      namespace: "gui.layout.text_wrap",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.display.text_measure,gui.document.render_token",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines primitive text wrapping behavior for document layout flow."
    };

    <edges>{
      %% graph TD
      %%   TextWrap --> TextMeasure
      %%   TextWrap --> RenderToken
      %%   WrapTextRun --> RenderToken
    };

    <book>{
      °struct •TextWrap {
        °define •lineCount: °usize;
      };

      °function •MakeTextWrap {
        °return •TextWrap;
      };

      °function •WrapTextRun {
        °define •wrap: •TextWrap;
        °define •token: •RenderToken;

        °set •wrap.lineCount = •wrap.lineCount + 1;

        °return •wrap;
      };
    };
  |■
|●
