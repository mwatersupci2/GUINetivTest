<Netiv="research/netiv-gui-bridge/lib/sim/fake-input.ntv">
○|
  □|
    <meta>{
      name: "gui.sim.fake_input",
      kind: "library",
      namespace: "gui.sim.fake_input",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.input.pointer,gui.input.keyboard,gui.kiosk.event_propagation",
      target: "simulation",
      notes: "Defines deterministic fake input events for Netiv kiosk runtime testing."
    };

    <edges>{
      %% graph TD
      %%   FakeInput --> PointerEvent
      %%   FakeInput --> KeyboardEvent
      %%   EmitFakePointer --> PropagatePointerEvent
      %%   EmitFakeKeyboard --> PropagateKeyboardEvent
    };

    <book>{
      °struct •FakeInput {
        °define •pointerCount: °usize;
        °define •keyboardCount: °usize;
      };

      °function •MakeFakeInput {
        °return •FakeInput;
      };

      °function •EmitFakePointer {
        °define •input: •FakeInput;
        °define •event: •PointerEvent;
        °set •input.pointerCount = •input.pointerCount + 1;
        °return •input;
      };

      °function •EmitFakeKeyboard {
        °define •input: •FakeInput;
        °define •event: •KeyboardEvent;
        °set •input.keyboardCount = •input.keyboardCount + 1;
        °return •input;
      };
    };
  |■
|●
