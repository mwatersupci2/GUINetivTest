<Netiv="research/netiv-gui-bridge/lib/sim/sim-journal.ntv">
○|
  □|
    <meta>{
      name: "gui.sim.sim_journal",
      kind: "library",
      namespace: "gui.sim.sim_journal",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.runtime.journal,gui.runtime.trace,apps.ebook_shell.prototype_runner",
      target: "simulation",
      notes: "Defines simulation journal recording for prototype kiosk execution."
    };

    <edges>{
      %% graph TD
      %%   SimJournal --> RuntimeJournal
      %%   SimJournal --> RuntimeTrace
      %%   SimJournal --> PrototypeRunner
      %%   RecordSimFrame --> RuntimeJournal
      %%   RecordSimTrace --> RuntimeTrace
    };

    <book>{
      °struct •SimJournal {
        °define •frameCount: °usize;
        °define •traceCount: °usize;
      };

      °function •MakeSimJournal {
        °return •SimJournal;
      };

      °function •RecordSimFrame {
        °define •journal: •SimJournal;
        °set •journal.frameCount = •journal.frameCount + 1;
        °return •journal;
      };

      °function •RecordSimTrace {
        °define •journal: •SimJournal;
        °set •journal.traceCount = •journal.traceCount + 1;
        °return •journal;
      };
    };
  |■
|●
