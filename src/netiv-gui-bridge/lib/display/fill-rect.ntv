<Netiv="research/netiv-gui-bridge/lib/display/fill-rect.ntv">
○|
  □|
    <meta>{
      name: "gui.display.fill_rect",
      kind: "library",
      namespace: "gui.display.fill_rect",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.display.frame_surface,gui.display.rect,gui.display.pixel",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines rectangle fill operations on frame surfaces."
    };

    <edges>{
      %% graph TD
      %%   FillRect --> FrameSurface
      %%   FillRect --> DisplayRect
      %%   FillRect --> TritPixel
    };

    <book>{
      °struct •FillRectOperation {
        °define •writeCount: °usize;
      };

      °function •MakeFillRectOperation {
        °return •FillRectOperation;
      };

      °function •FillSurfaceRect {
        °define •operation: •FillRectOperation;
        °define •surface: •FrameSurface;
        °define •bounds: •DisplayRect;
        °define •pixel: •TritPixel;

        °set •surface.dirty = true;
        °set •surface.writeCount = •surface.writeCount + 1;
        °set •operation.writeCount = •operation.writeCount + 1;

        °return •surface;
      };
    };
  |■
|●
