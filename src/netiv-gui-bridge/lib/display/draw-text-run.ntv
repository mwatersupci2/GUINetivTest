<Netiv="research/netiv-gui-bridge/lib/display/draw-text-run.ntv">
○|
  □|
    <meta>{
      name: "gui.display.draw_text_run",
      kind: "library",
      namespace: "gui.display.draw_text_run",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.display.frame_surface,gui.display.glyph_cache,gui.display.pixel",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines text run rendering operations for frame surfaces."
    };

    <edges>{
      %% graph TD
      %%   DrawTextRun --> FrameSurface
      %%   DrawTextRun --> GlyphCache
      %%   DrawTextRun --> TritPixel
    };

    <book>{
      °struct •TextRun {
        °define •glyphCount: °usize;
        °define •visible: °bool;
      };

      °struct •DrawTextRunOperation {
        °define •drawCount: °usize;
      };

      °function •MakeTextRun {
        °return •TextRun;
      };

      °function •MakeDrawTextRunOperation {
        °return •DrawTextRunOperation;
      };

      °function •DrawSurfaceTextRun {
        °define •operation: •DrawTextRunOperation;
        °define •surface: •FrameSurface;
        °define •cache: •GlyphCache;
        °define •run: •TextRun;

        °set •surface.dirty = true;
        °set •surface.writeCount = •surface.writeCount + 1;
        °set •operation.drawCount = •operation.drawCount + 1;

        °return •surface;
      };
    };
  |■
|●
