<Netiv="research/netiv-gui-bridge/lib/display/text-measure.ntv">
○|
  □|
    <meta>{
      name: "gui.display.text_measure",
      kind: "library",
      namespace: "gui.display.text_measure",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.display.draw_text_run,gui.display.rect",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines shared text measurement semantics for layout and text rendering."
    };

    <edges>{
      %% graph TD
      %%   TextMeasure --> TextRun
      %%   TextMeasure --> DisplayRect
      %%   MeasureTextRun --> TextRun
    };

    <book>{
      °struct •TextMeasure {
        °define •width: °i64;
        °define •height: °i64;
      };

      °function •MakeTextMeasure {
        °return •TextMeasure;
      };

      °function •MeasureTextRun {
        °define •measure: •TextMeasure;
        °define •run: •TextRun;

        °set •measure.width = •run.glyphCount;
        °set •measure.height = 1;

        °return •measure;
      };
    };
  |■
|●
