<Netiv="research/netiv-gui-bridge/lib/runtime/loop.ntv">
○|
  □|
    <meta>{
      name: "gui.runtime.loop",
      kind: "library",
      namespace: "gui.runtime.loop",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.runtime.tick,gui.kiosk.screen",
      target: "windows-native-window",
      notes: "Defines the deterministic runtime loop for Netiv kiosk applications."
    };

    <edges>{
      %% graph TD
      %%   RuntimeLoop --> RuntimeClock
      %%   RuntimeLoop --> KioskScreen
      %%   RuntimeLoopInput --> TickPhase
      %%   RuntimeLoopUpdate --> TickPhase
      %%   RuntimeLoopRender --> ScreenRender
      %%   RuntimeLoopPresent --> ScreenRender
      %%   RuntimeLoopFrame --> RuntimeLoop
    };

    <book>{
      °struct •RuntimeLoop {
        °define •clock: •RuntimeClock;
        °define •screen: •KioskScreen;
        °define •running: °bool;
      };

      °function •MakeRuntimeLoop {
        °define •clock: •RuntimeClock;
        °define •screen: •KioskScreen;
        °return •RuntimeLoop;
      };

      °function •RuntimeLoopInput {
        °define •loop: •RuntimeLoop;
        °set •loop.clock = •AdvanceTick(•loop.clock, •input);
        °return •loop;
      };

      °function •RuntimeLoopUpdate {
        °define •loop: •RuntimeLoop;
        °set •loop.clock = •AdvanceTick(•loop.clock, •update);
        °return •loop;
      };

      °function •RuntimeLoopRender {
        °define •loop: •RuntimeLoop;
        °set •loop.clock = •AdvanceTick(•loop.clock, •render);
        °set •loop.screen = •ScreenRender(•loop.screen);
        °return •loop;
      };

      °function •RuntimeLoopPresent {
        °define •loop: •RuntimeLoop;
        °set •loop.clock = •AdvanceTick(•loop.clock, •present);
        °return •loop;
      };

      °function •RuntimeLoopFrame {
        °define •loop: •RuntimeLoop;
        °set •loop = •RuntimeLoopInput(•loop);
        °set •loop = •RuntimeLoopUpdate(•loop);
        °set •loop = •RuntimeLoopRender(•loop);
        °set •loop = •RuntimeLoopPresent(•loop);
        °return •loop;
      };
    };
  |■
|●
