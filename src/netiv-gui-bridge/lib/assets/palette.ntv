<Netiv="research/netiv-gui-bridge/lib/assets/palette.ntv">
○|
  □|
    <meta>{
      name: "gui.assets.palette",
      kind: "library",
      namespace: "gui.assets.palette",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.display.pixel",
      target: "windows-native-window",
      notes: "Defines reusable trit-to-host color palettes for the Netiv E-Book Shell dark terminal theme, offline kiosk themes, ebook modes, debug modes, and e-ink style rendering."
    };

    <edges>{
      %% graph TD
      %%   AssetPalette --> PixelPalette
      %%   AssetPalette --> PaletteKind
      %%   MakeDebugPaletteAsset --> AssetPalette
      %%   MakeEinkPaletteAsset --> AssetPalette
      %%   MakeKioskPaletteAsset --> AssetPalette
    };

    <book>{
      °enum •PaletteKind {
        •debugRgb,
        •einkGray,
        •kioskSoft,
        •highContrast,
        •netivDarkShell
      };

      °struct •AssetPalette {
        °define •kind: •PaletteKind;
        °define •palette: •PixelPalette;
      };

      °function •MakeAssetPalette {
        °define •kind: •PaletteKind;
        °define •palette: •PixelPalette;
        °return •AssetPalette;
      };

      °function •MakeDebugPaletteAsset {
        °define •palette: •PixelPalette;
        °set •palette = •MakeDebugRgbPalette();
        °return •MakeAssetPalette(•debugRgb, •palette);
      };

      °function •MakeEinkPaletteAsset {
        °define •palette: •PixelPalette;
        °set •palette = •MakeEinkGrayPalette();
        °return •MakeAssetPalette(•einkGray, •palette);
      };

      °function •MakeNetivDarkShellPalette {
        °define •palette: •PixelPalette;
        °set •palette = •MakeDebugRgbPalette();
        °return •MakeAssetPalette(•netivDarkShell, •palette);
      };
    };
  |■
|●
