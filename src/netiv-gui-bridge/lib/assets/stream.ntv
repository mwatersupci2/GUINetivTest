<Netiv="research/netiv-gui-bridge/lib/assets/stream.ntv">
○|
  □|
    <meta>{
      name: "gui.assets.stream",
      kind: "library",
      namespace: "gui.assets.stream",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.assets.pack,gui.assets.cache",
      target: "windows-native-window",
      notes: "Defines incremental asset streaming for low-memory Netiv kiosk and ebook-shell environments."
    };

    <edges>{
      %% graph TD
      %%   AssetStream --> AssetPack
      %%   AssetStream --> AssetCache
      %%   AssetStream --> StreamState
      %%   StreamOpen --> AssetStream
      %%   StreamNext --> AssetStream
      %%   StreamClose --> AssetStream
    };

    <book>{
      °enum •StreamState {
        •closed,
        •opened,
        •reading,
        •completed,
        •error
      };

      °struct •AssetStream {
        °define •state: •StreamState;
        °define •cursor: °usize;
        °define •remaining: °usize;
      };

      °function •MakeAssetStream {
        °define •remaining: °usize;
        °return •AssetStream;
      };

      °function •StreamOpen {
        °define •stream: •AssetStream;
        °set •stream.state = •opened;
        °return •stream;
      };

      °function •StreamNext {
        °define •stream: •AssetStream;

        °if { •stream.remaining == 0 } {
          °set •stream.state = •completed;
          °return •stream;
        };

        °set •stream.state = •reading;
        °set •stream.cursor = •stream.cursor + 1;
        °set •stream.remaining = •stream.remaining - 1;
        °return •stream;
      };

      °function •StreamClose {
        °define •stream: •AssetStream;
        °set •stream.state = •closed;
        °return •stream;
      };
    };
  |■
|●
