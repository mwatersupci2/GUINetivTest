<Netiv="research/netiv-gui-bridge/lib/assets/font.ntv">
○|
  □|
    <meta>{
      name: "gui.assets.font",
      kind: "library",
      namespace: "gui.assets.font",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.display.text",
      target: "windows-native-window",
      notes: "Defines bitmap and trinary glyph font assets for the Netiv kiosk runtime."
    };

    <edges>{
      %% graph TD
      %%   FontAsset --> GlyphCell
      %%   FontAsset --> FontKind
      %%   ResolveGlyph --> FontAsset
      %%   ResolveGlyph --> GlyphCell
      %%   LoadFontAsset --> FontAsset
    };

    <book>{
      °enum •FontKind {
        •bitmap,
        •trinaryGlyph,
        •debug,
        •eink
      };

      °struct •FontAsset {
        °define •kind: •FontKind;
        °define •glyphCount: °usize;
        °define •cellWidth: °i64;
        °define •cellHeight: °i64;
      };

      °function •MakeFontAsset {
        °define •kind: •FontKind;
        °define •glyphCount: °usize;
        °define •cellWidth: °i64;
        °define •cellHeight: °i64;
        °return •FontAsset;
      };

      °function •LoadFontAsset {
        °define •font: •FontAsset;
        °return •font;
      };

      °function •ResolveGlyph {
        °define •font: •FontAsset;
        °define •ordinal: °usize;
        °return •GlyphCell;
      };
    };
  |■
|●
