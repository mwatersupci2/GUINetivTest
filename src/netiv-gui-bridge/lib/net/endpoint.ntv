<Netiv="research/netiv-gui-bridge/lib/net/endpoint.ntv">
○|
  □|
    <meta>{
      name: "gui.net.endpoint",
      kind: "library",
      namespace: "gui.net.endpoint",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core",
      target: "windows-native-window",
      notes: "Defines server endpoint contracts for pulling offline kiosk and ebook page packs from a trusted server."
    };

    <edges>{
      %% graph TD
      %%   NetEndpoint --> EndpointKind
      %%   NetEndpoint --> EndpointState
      %%   ConnectEndpoint --> NetEndpoint
      %%   DisconnectEndpoint --> NetEndpoint
      %%   EndpointReady --> NetEndpoint
    };

    <book>{
      °enum •EndpointKind {
        •assetServer,
        •pageServer,
        •updateServer,
        •debugServer
      };

      °enum •EndpointState {
        •closed,
        •connecting,
        •open,
        •error
      };

      °struct •NetEndpoint {
        °define •kind: •EndpointKind;
        °define •state: •EndpointState;
        °define •trusted: °bool;
      };

      °function •MakeNetEndpoint {
        °define •kind: •EndpointKind;
        °define •trusted: °bool;
        °return •NetEndpoint;
      };

      °function •ConnectEndpoint {
        °define •endpoint: •NetEndpoint;
        °set •endpoint.state = •open;
        °return •endpoint;
      };

      °function •DisconnectEndpoint {
        °define •endpoint: •NetEndpoint;
        °set •endpoint.state = •closed;
        °return •endpoint;
      };

      °function •EndpointReady {
        °define •endpoint: •NetEndpoint;

        °if { •endpoint.state == •open } {
          °return true;
        };

        °return false;
      };
    };
  |■
|●
