<Netiv="research/netiv-gui-bridge/lib/net/sync.ntv">
○|
  □|
    <meta>{
      name: "gui.net.sync",
      kind: "library",
      namespace: "gui.net.sync",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.net.endpoint,gui.net.manifest,gui.assets.pack,gui.assets.cache",
      target: "windows-native-window",
      notes: "Defines offline-first synchronization semantics for Netiv kiosk content updates."
    };

    <edges>{
      %% graph TD
      %%   SyncSession --> NetEndpoint
      %%   SyncSession --> RemoteManifest
      %%   SyncSession --> SyncState
      %%   BeginSync --> SyncSession
      %%   SyncNextPack --> AssetPack
      %%   CompleteSync --> SyncSession
    };

    <book>{
      °enum •SyncState {
        •idle,
        •connecting,
        •syncing,
        •completed,
        •error
      };

      °struct •SyncSession {
        °define •state: •SyncState;
        °define •remainingPacks: °usize;
      };

      °function •MakeSyncSession {
        °define •remainingPacks: °usize;
        °return •SyncSession;
      };

      °function •BeginSync {
        °define •session: •SyncSession;
        °define •endpoint: •NetEndpoint;
        °set •session.state = •syncing;
        °return •session;
      };

      °function •SyncNextPack {
        °define •session: •SyncSession;

        °if { •session.remainingPacks == 0 } {
          °set •session.state = •completed;
          °return •session;
        };

        °set •session.remainingPacks = •session.remainingPacks - 1;
        °return •session;
      };

      °function •CompleteSync {
        °define •session: •SyncSession;
        °set •session.state = •completed;
        °return •session;
      };
    };
  |■
|●
