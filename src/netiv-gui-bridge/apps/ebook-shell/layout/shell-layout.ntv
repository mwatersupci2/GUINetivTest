<Netiv="research/netiv-gui-bridge/apps/ebook-shell/layout/shell-layout.ntv">
○|
  □|
    <meta>{
      name: "ebook_shell.layout.shell_layout",
      kind: "application-layout",
      namespace: "apps.ebook_shell.layout.shell_layout",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.display.rect,gui.layout.tachyon_layout,apps.ebook_shell.widgets.tab_bar,apps.ebook_shell.widgets.page_container",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines deterministic shell layout regions for ebook-shell using Tachyons.css-inspired Netiv utility layout atoms."
    };

    <edges>{
      %% graph TD
      %%   ShellLayout --> DisplayRect
      %%   ShellLayout --> TabBar
      %%   ShellLayout --> PageContainer
      %%   LayoutShell --> DisplayRect
    };

    <book>{
      °struct •ShellLayout {
        °define •regionCount: °usize;
        °define •layoutEngine: •TachyonLayoutEngine;
      };

      °function •MakeShellLayout {
        °return •ShellLayout;
      };

      °function •LayoutShell {
        °define •layout: •ShellLayout;
        °set •layout.layoutEngine = •LayoutEbookShellDashboard(•layout.layoutEngine);
        °set •layout.regionCount = •layout.regionCount + 1;
        °return •layout;
      };
    };
  |■
|●
