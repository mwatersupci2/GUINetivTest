<Netiv="research/netiv-gui-bridge/apps/ebook-shell/state/app-state.ntv">
○|
  □|
    <meta>{
      name: "ebook_shell.state.app_state",
      kind: "application-state",
      namespace: "apps.ebook_shell.state.app_state",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.runtime.tick,gui.kiosk.screen",
      target: "windows-native-window",
      notes: "Defines top-level ebook-shell application state for the Netiv trinary kiosk proving app."
    };

    <edges>{
      %% graph TD
      %%   EbookShellState --> EbookRoute
      %%   EbookShellState --> RuntimeTick
      %%   EbookShellState --> KioskScreen
      %%   InitEbookShellState --> EbookShellState
      %%   UpdateEbookShellState --> EbookShellState
    };

    <book>{
      °enum •EbookRoute {
        •home,
        •reader,
        •library,
        •settings,
        •debug
      };

      °struct •EbookShellState {
        °define •route: •EbookRoute;
        °define •pageIndex: °usize;
        °define •running: °bool;
      };

      °function •InitEbookShellState {
        °define •state: •EbookShellState;
        °set •state.route = •home;
        °set •state.pageIndex = 0;
        °set •state.running = true;
        °return •state;
      };

      °function •SetEbookRoute {
        °define •state: •EbookShellState;
        °define •route: •EbookRoute;
        °set •state.route = •route;
        °return •state;
      };

      °function •UpdateEbookShellState {
        °define •state: •EbookShellState;
        °define •tick: •RuntimeTick;
        °return •state;
      };
    };
  |■
|●
