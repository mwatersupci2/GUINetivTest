<Netiv="research/netiv-gui-bridge/apps/ebook-shell/state/tab-state.ntv">
○|
  □|
    <meta>{
      name: "ebook_shell.state.tab_state",
      kind: "application-state",
      namespace: "apps.ebook_shell.state.tab_state",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,apps.ebook_shell.state.app_state",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines expanded tab application state for the ebook-shell interface."
    };

    <book>{
      °enum •ShellTab {
        •home,
        •files,
        •wiki,
        •notes,
        •todo,
        •lessons,
        •csv,
        •graph,
        •console,
        •compiler,
        •observability,
        •systems,
        •pods,
        •network,
        •chat,
        •settings
      };

      °struct •TabState {
        °define •active: •ShellTab;
        °define •tabCount: °usize;
      };

      °function •MakeTabState {
        °return •TabState;
      };
    };
