<Netiv="research/netiv-gui-bridge/apps/ebook-shell/render/files-renderer.ntv">
○|
  □|
    <meta>{
      name: "ebook_shell.render.files_renderer",
      kind: "application-renderer",
      namespace: "apps.ebook_shell.render.files_renderer",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,apps.ebook_shell.pages.files_page,apps.ebook_shell.widgets.file_tree,gui.document.document_page_render,gui.display.frame_surface",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines rendering behavior for the ebook-shell local files browser page."
    };

    <edges>{
      %% graph TD
      %%   FilesRenderer --> FilesPage
      %%   FilesRenderer --> FileTree
      %%   FilesRenderer --> DocumentPageRender
      %%   RenderFilesView --> FrameSurface
    };

    <book>{
      °struct •FilesRenderer {
        °define •renderCount: °usize;
      };

      °function •MakeFilesRenderer {
        °return •FilesRenderer;
      };

      °function •RenderFilesView {
        °define •renderer: •FilesRenderer;
        °define •page: •FilesPage;
        °define •surface: •FrameSurface;

        °set •surface.dirty = true;
        °set •renderer.renderCount = •renderer.renderCount + 1;

        °return •surface;
      };
    };
  |■
|●
