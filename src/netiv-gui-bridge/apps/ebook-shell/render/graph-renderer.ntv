<Netiv="research/netiv-gui-bridge/apps/ebook-shell/render/graph-renderer.ntv">
○|
  □|
    <meta>{
      name: "ebook_shell.render.graph_renderer",
      kind: "application-renderer",
      namespace: "apps.ebook_shell.render.graph_renderer",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,apps.ebook_shell.pages.graph_page,gui.graph.graph_node_render,gui.graph.graph_edge_render,gui.display.frame_surface",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines rendering behavior for the ebook-shell Mermaid graph canvas page."
    };

    <edges>{
      %% graph TD
      %%   GraphRenderer --> GraphPage
      %%   GraphRenderer --> GraphNodeRender
      %%   GraphRenderer --> GraphEdgeRender
      %%   RenderGraphView --> FrameSurface
    };

    <book>{
      °struct •GraphRenderer {
        °define •renderCount: °usize;
      };

      °function •MakeGraphRenderer {
        °return •GraphRenderer;
      };

      °function •RenderGraphView {
        °define •renderer: •GraphRenderer;
        °define •page: •GraphPage;
        °define •surface: •FrameSurface;

        °set •surface.dirty = true;
        °set •renderer.renderCount = •renderer.renderCount + 1;

        °return •surface;
      };
    };
  |■
