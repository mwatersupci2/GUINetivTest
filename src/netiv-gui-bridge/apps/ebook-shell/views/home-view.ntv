<Netiv="research/netiv-gui-bridge/apps/ebook-shell/views/home-view.ntv">
○|
  □|
    <meta>{
      name: "ebook_shell.views.home_view",
      kind: "application-view",
      namespace: "apps.ebook_shell.views.home_view",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.kiosk.panel,gui.kiosk.button,gui.display.text,apps.ebook_shell.state.app_state",
      target: "windows-native-window",
      notes: "Defines the initial home screen composition for the ebook-shell proving application."
    };

    <edges>{
      %% graph TD
      %%   HomeView --> KioskPanel
      %%   HomeView --> KioskButton
      %%   HomeView --> TextRun
      %%   RenderHomeView --> EbookShellState
      %%   RenderHomeView --> RenderPanel
      %%   RenderHomeView --> RenderButton
    };

    <book>{
      °struct •HomeView {
        °define •titleLength: °usize;
      };

      °function •MakeHomeView {
        °return •HomeView;
      };

      °function •RenderHomeView {
        °define •ctx: •CanvasContext2D;
        °define •state: •EbookShellState;
        °define •view: •HomeView;
        °return •ctx;
      };
    };
