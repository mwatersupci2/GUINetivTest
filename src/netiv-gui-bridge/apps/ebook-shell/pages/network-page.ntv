<Netiv="research/netiv-gui-bridge/apps/ebook-shell/pages/network-page.ntv">
○|
  □|
    <meta>{
      name: "ebook_shell.pages.network_page",
      kind: "application-page",
      namespace: "apps.ebook_shell.pages.network_page",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.layout.tachyon_layout,gui.document.document_page_render",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines the network page for ebook-shell."
    };

    <book>{
      °struct •NetworkPage {
        °define •nodeCount: °usize;
        °define •visible: °bool;
        °define •layout: •TachyonLayoutEngine;
      };

      °function •MakeNetworkPage {
        °return •NetworkPage;
      };

      °function •RenderNetworkPage {
        °define •page: •NetworkPage;
        °set •page.layout = •LayoutNetworkPage(•page.layout);
        °set •page.visible = true;
        °return •page;
      };
    };
