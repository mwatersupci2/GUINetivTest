<Netiv="research/netiv-gui-bridge/apps/ebook-shell/pages/chat-page.ntv">
○|
  □|
    <meta>{
      name: "ebook_shell.pages.chat_page",
      kind: "application-page",
      namespace: "apps.ebook_shell.pages.chat_page",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.layout.tachyon_layout,gui.document.document_page_render",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines the embedded AI chat window page for ebook-shell."
    };

    <book>{
      °struct •ChatMessage {
        °define •fromUser: °bool;
        °define •visible: °bool;
      };

      °struct •ChatPage {
        °define •messageCount: °usize;
        °define •streaming: °bool;
        °define •layout: •TachyonLayoutEngine;
      };

      °function •MakeChatPage {
        °return •ChatPage;
      };

      °function •RenderChatPage {
        °define •page: •ChatPage;
        °set •page.layout = •LayoutChatPage(•page.layout);
        °set •page.streaming = true;
        °return •page;
      };
    };
