<Netiv="research/netiv-gui-bridge/apps/ebook-shell/pages/files-page.ntv">
○|
  □|
    <meta>{
      name: "ebook_shell.pages.files_page",
      kind: "application-page",
      namespace: "apps.ebook_shell.pages.files_page",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,gui.layout.tachyon_layout,gui.document.html_tokenizer,gui.document.css_tokenizer,gui.document.link_map",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines the static HTML and CSS document browser page with file-tree navigation."
    };

    <edges>{
      %% graph TD
      %%   FilesPage --> HtmlTokenizer
      %%   FilesPage --> CssTokenizer
      %%   FilesPage --> LinkMap
      %%   RenderFilesPage --> LayoutFilesPage
      %%   RenderFilesPage --> HtmlTokenizer
    };

    <book>{
      °struct •FilesPage {
        °define •fileCount: °usize;
        °define •selectedOrdinal: °usize;
        °define •treeVisible: °bool;
        °define •layout: •TachyonLayoutEngine;
      };

      °function •MakeFilesPage {
        °return •FilesPage;
      };

      °function •RenderFilesPage {
        °define •page: •FilesPage;
        °set •page.layout = •LayoutFilesPage(•page.layout);
        °set •page.treeVisible = true;
        °return •page;
      };
    };
  |■
|●
