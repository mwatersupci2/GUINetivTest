<Netiv="research/netiv-gui-bridge/apps/ebook-shell/widgets/tab-bar.ntv">
○|
  □|
    <meta>{
      name: "ebook_shell.widgets.tab_bar",
      kind: "application-widget",
      namespace: "apps.ebook_shell.widgets.tab_bar",
      version: "0.1.0",
      error: "terminal",
      status: "future-active-draft",
      imports: "trit.core,apps.ebook_shell.state.tab_state,gui.layout.tachyon_layout,gui.document.hit_region,gui.display.frame_surface,gui.display.fill_rect,gui.display.draw_text_run",
      target: "binary-hosted-trinary-runtime",
      notes: "Defines the top navigation tab bar. Tab button positions are ordered by the Tachyons-inspired Netiv layout engine rather than hardcoded by the host."
    };

    <edges>{
      %% graph TD
      %%   TabBar --> TabState
      %%   TabBar --> HitRegion
      %%   RenderTabBar --> FrameSurface
      %%   SelectTabBarHit --> TabState
    };

    <book>{
      °struct •TabBar {
        °define •tabCount: °usize;
        °define •active: •ShellTab;
        °define •visible: °bool;
        °define •layout: •TachyonLayoutEngine;
      };

      °function •MakeTabBar {
        °define •state: •TabState;
        °return •TabBar;
      };

      °function •RenderTabBar {
        °define •bar: •TabBar;
        °define •surface: •FrameSurface;
        °set •bar.layout = •LayoutTopTabs(•bar.layout, •bar.tabCount);
        °set •surface.dirty = true;
        °return •surface;
      };

      °function •SelectTabBarHit {
        °define •bar: •TabBar;
        °define •state: •TabState;
        °define •region: •HitRegion;
        °return •state;
      };
    };
  |■
|●
